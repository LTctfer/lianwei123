{
  "warning_rules": {
    "R001": {
      "rule_name": "燃烧室温度不达标",
      "description": "燃烧室温度未达到规定值760℃以上，废气提前进入处理系统",
      "data_column": "temperature_combustion",
      "condition": "less_than",
      "threshold_value": 760,
      "threshold_unit": "℃",
      "severity": "high",
      "equipment": "燃烧室",
      "is_active": true
    },
    "R002": {
      "rule_name": "废气出口污染物浓度超标",
      "description": "废气出口污染物浓度超标",
      "data_column": "concentration_out",
      "condition": "greater_than",
      "threshold_value": 50,
      "threshold_unit": "mg/m³",
      "severity": "critical",
      "equipment": "废气出口",
      "is_active": true
    },
    "R003": {
      "rule_name": "应急阀门违规开启",
      "description": "应急阀门违规开启",
      "data_column": "emergency_valve",
      "condition": "equals",
      "threshold_value": 1,
      "threshold_unit": "",
      "severity": "critical",
      "equipment": "应急阀门",
      "is_active": true
    },
    "R004": {
      "rule_name": "处理效率不达标",
      "description": "处理效率不达标（出口浓度/进口浓度）",
      "data_column": "treatment_efficiency",
      "condition": "less_than",
      "threshold_value": 0.9,
      "threshold_unit": "",
      "severity": "high",
      "equipment": "处理系统",
      "is_active": true
    },
    "R005": {
      "rule_name": "废气出口温度超标",
      "description": "废气出口温度不能超过60℃",
      "data_column": "temperature_outlet",
      "condition": "greater_than",
      "threshold_value": 60,
      "threshold_unit": "℃",
      "severity": "medium",
      "equipment": "废气出口",
      "is_active": true
    },
    "R006": {
      "rule_name": "治污设备未先启后停",
      "description": "治污设备未先启后停",
      "data_column": "equipment_sequence_error",
      "condition": "equals",
      "threshold_value": 1,
      "threshold_unit": "",
      "severity": "high",
      "equipment": "治污设备",
      "is_active": true
    },
    "R007": {
      "rule_name": "吸附设施温度异常",
      "description": "吸附温度未达到规定温度要求（默认值：不超过40℃，可调整）",
      "data_column": "temperature_adsorption",
      "condition": "greater_than",
      "threshold_value": 40,
      "threshold_unit": "℃",
      "severity": "medium",
      "equipment": "吸附设施",
      "is_active": true
    },
    "R008": {
      "rule_name": "脱附设施温度异常",
      "description": "脱附温度未达到规定温度要求（默认值：大于等于90℃，小于等于120℃，可调整）",
      "data_column": "temperature_desorption",
      "condition": "out_of_range",
      "threshold_min": 90,
      "threshold_max": 120,
      "threshold_unit": "℃",
      "severity": "medium",
      "equipment": "脱附设施",
      "is_active": true
    },
    "R009": {
      "rule_name": "脱附时长不符合要求",
      "description": "脱附时长未达到规定要求（默认值：大于等于3h，可调整）",
      "data_column": "desorption_duration",
      "condition": "less_than",
      "threshold_value": 3,
      "threshold_unit": "小时",
      "severity": "medium",
      "equipment": "脱附设施",
      "is_active": true
    },
    "R010": {
      "rule_name": "长期未脱附",
      "description": "生产状态时，检查历史脱附记录，超过一定时间未进行脱附（默认值：小于等于1个月，可调整）",
      "data_column": "days_since_last_desorption",
      "condition": "greater_than",
      "threshold_value": 30,
      "threshold_unit": "天",
      "severity": "high",
      "equipment": "脱附设施",
      "is_active": true
    },
    "R011": {
      "rule_name": "活性炭吸附已经饱和",
      "description": "根据进出口处理效率判断活性炭吸附饱和",
      "data_column": "carbon_saturation",
      "condition": "greater_than",
      "threshold_value": 0.8,
      "threshold_unit": "",
      "severity": "high",
      "equipment": "活性炭吸附装置",
      "is_active": true
    },
    "R012": {
      "rule_name": "过滤材料已失效",
      "description": "经过预处理后，废气中颗粒物含量不超过10mg/立方;预处理过滤装置的压力损失不超过1KPA",
      "data_column": "particle_content",
      "condition": "greater_than",
      "threshold_value": 10,
      "threshold_unit": "mg/m³",
      "severity": "medium",
      "equipment": "过滤装置",
      "is_active": true
    },
    "R013": {
      "rule_name": "进入催化燃烧装置的废气温度超标",
      "description": "进入催化燃烧装置的废气温度不超过400℃",
      "data_column": "temperature_inlet_catalytic",
      "condition": "greater_than",
      "threshold_value": 400,
      "threshold_unit": "℃",
      "severity": "high",
      "equipment": "催化燃烧装置",
      "is_active": true
    },
    "R014": {
      "rule_name": "预热室温度异常",
      "description": "催化燃烧装置预热室温度，不应超过400摄氏度，宜控制在250-350之间",
      "data_column": "temperature_preheat",
      "condition": "out_of_range",
      "threshold_min": 250,
      "threshold_max": 400,
      "threshold_unit": "℃",
      "severity": "medium",
      "equipment": "预热室",
      "is_active": true
    },
    "R015": {
      "rule_name": "催化燃烧装置压力异常",
      "description": "催化燃烧装置的压力损失应低于2kpa",
      "data_column": "pressure_loss_catalytic",
      "condition": "greater_than",
      "threshold_value": 2,
      "threshold_unit": "kPa",
      "severity": "medium",
      "equipment": "催化燃烧装置",
      "is_active": true
    },
    "R016": {
      "rule_name": "反应器出口温度异常",
      "description": "反应器出口温度超过600摄氏度，冲稀设施（风机需自动开启）",
      "data_column": "temperature_reactor_outlet",
      "condition": "greater_than",
      "threshold_value": 600,
      "threshold_unit": "℃",
      "severity": "critical",
      "equipment": "反应器",
      "is_active": true
    },
    "R017": {
      "rule_name": "催化剂使用周期超标",
      "description": "催化剂使用周期超标",
      "data_column": "catalyst_usage_days",
      "condition": "greater_than",
      "threshold_value": 365,
      "threshold_unit": "天",
      "severity": "high",
      "equipment": "催化剂",
      "is_active": true
    }
  },
  "data_cleaning": {
    "remove_negative_values": true,
    "remove_zero_values": true,
    "remove_outliers": true,
    "outlier_method": "IQR",
    "outlier_factor": 1.5,
    "fill_method": "forward_fill",
    "key_columns": [
      "temperature_combustion",
      "temperature_outlet", 
      "concentration_in",
      "concentration_out",
      "temperature_adsorption",
      "temperature_desorption",
      "temperature_reactor_outlet"
    ]
  },
  "visualization": {
    "colors": {
      "low": "#28a745",
      "medium": "#ffc107",
      "high": "#fd7e14", 
      "critical": "#dc3545"
    },
    "chart_style": "seaborn",
    "figure_size": [15, 8],
    "dpi": 300
  },
  "reporting": {
    "auto_generate_report": true,
    "report_formats": ["xlsx", "pdf", "png"],
    "output_directory": "reports",
    "include_charts": true,
    "include_summary": true,
    "include_recommendations": true
  },
  "system_settings": {
    "timezone": "Asia/Shanghai",
    "language": "zh_CN",
    "log_level": "INFO",
    "max_violation_records": 10000,
    "data_retention_days": 365
  }
}
