{
  "plc_settings": {
    "host": "192.168.0.1",
    "port": 502,
    "unit_id": 1,
    "timeout": 5.0,
    "description": "PLC Modbus TCP/IP配置"
  },
  "address_mapping_rules": {
    "description": "地址映射规则说明",
    "Q_area": {
      "description": "输出线圈区域",
      "base_address": 0,
      "formula": "Q字节号 * 8 + 位号",
      "examples": {
        "Q0.0": 0,
        "Q0.1": 1,
        "Q10.1": 81,
        "Q20.0": 160
      }
    },
    "I_area": {
      "description": "输入线圈区域", 
      "base_address": 10000,
      "formula": "10000 + I字节号 * 8 + 位号",
      "examples": {
        "I0.0": 10000,
        "I0.7": 10007
      }
    },
    "M_area": {
      "description": "标志位区域",
      "base_address": 20000,
      "formula": "20000 + M字节号 * 8 + 位号",
      "examples": {
        "M0.0": 20000,
        "M1.1": 20009,
        "M100.0": 20800
      }
    },
    "MW_area": {
      "description": "标志字区域",
      "base_address": 40000,
      "formula": "40000 + MW地址",
      "examples": {
        "MW100": 40100,
        "MD100": 40050
      }
    }
  },
  "data_types": {
    "Bool": {
      "size_bits": 1,
      "description": "布尔值"
    },
    "Word": {
      "size_bits": 16,
      "description": "16位无符号整数"
    },
    "DWord": {
      "size_bits": 32,
      "description": "32位无符号整数"
    },
    "UDInt": {
      "size_bits": 32,
      "description": "32位无符号整数"
    },
    "DInt": {
      "size_bits": 32,
      "description": "32位有符号整数"
    },
    "Real": {
      "size_bits": 32,
      "description": "32位IEEE754浮点数"
    },
    "Time": {
      "size_bits": 32,
      "description": "时间类型(毫秒)"
    }
  },
  "key_tags": [
    "横轴_脉冲",
    "横轴_方向", 
    "竖轴_脉冲",
    "竖轴_方向",
    "横轴_LowHwLimitSwitch",
    "横轴_HighHwLimitSwitch",
    "横轴_归位开关",
    "竖轴_HighHwLimitSwitch",
    "竖轴_LowHwLimitSwitch",
    "竖轴_归位开关",
    "Tag_4",
    "Tag_8"
  ],
  "monitoring": {
    "poll_interval": 1.0,
    "log_changes_only": true,
    "save_to_csv": true,
    "csv_filename": "plc_data_log.csv"
  }
}
